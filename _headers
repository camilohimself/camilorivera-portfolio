/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

/*.webp
  Cache-Control: public, max-age=31536000

/*.mp4
  Cache-Control: public, max-age=31536000

# CSS/JS : chaque référence porte l’empreinte du contenu (?v=, posée par
# node tools/version-assets.mjs --write, vérifiée par tools/validate-journal.mjs).
# Un fichier modifié change d’adresse : cache d’un an sans revalidation.
# Le HTML, works.json et les .json du journal restent revalidés.
/*.css
  Cache-Control: public, max-age=31536000, immutable

/*.js
  Cache-Control: public, max-age=31536000, immutable

/works.json
  Cache-Control: public, max-age=0, must-revalidate

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/index.html
  Cache-Control: public, max-age=0, must-revalidate
